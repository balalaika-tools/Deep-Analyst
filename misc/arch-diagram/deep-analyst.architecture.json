  "cards": [
    {
      "dot": "emerald",
      "title": "Ingestion",
      "items": [
        "Three input families cover CDR, email, bank, and document sources",
        "Deterministic rules emit confirmed edges; the LLM proposes candidates that the application validates",
        "Pipeline and GenAI spans are exported to Langfuse"
      ]
    },
    {
      "dot": "cyan",
      "title": "Orchestration",
      "items": [
        "One checkpointed Investigator Agent selects exactly three read-only tools",
        "Hybrid RAG and text-to-SQL are nested agents; graph traversal is deterministic",
        "Agent, model, and tool traces are exported to Langfuse"
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence graph",
      "items": [
        "The graph is relational: entities and relationships are stored in PostgreSQL",
        "BM25 and vector indexes are rebuildable projections of the same evidence store"
      ]
