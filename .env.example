# Container set verified against the upstream Langfuse v4 Compose topology on 2026-09-01.
# Tags document the release line; digests make the local stack reproducible.
LANGFUSE_VERSION=4.22.0
LANGFUSE_WEB_IMAGE_DIGEST=sha256:88555cbf8659a755c45843be92ece7e06ca2975dd4a33f2cd9d1f7287df98b25
LANGFUSE_WORKER_IMAGE_DIGEST=sha256:6093fc77d81a9579c53147ac422f6deefbe3e65d8c0edd24253f282aefbf74be
CLICKHOUSE_VERSION=25.12
CLICKHOUSE_IMAGE_DIGEST=sha256:8a790dd3468db22b1d4e7b18a176f378ff5ff6053b9c48dd4ea1fa71a24c5ba6
POSTGRES_VERSION=17
POSTGRES_IMAGE_DIGEST=sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675
REDIS_VERSION=7.2
REDIS_IMAGE_DIGEST=sha256:74566c6910d13ae61e7ce73ebd3127438a1fe805b309b097c323142719ec8a5b
MINIO_IMAGE_DIGEST=sha256:1e408150bcf1bff07a2e468b9ac91347d4da261258921faeaedbe2ed7f0818b4
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z
MINIO_MC_IMAGE_DIGEST=sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

# Local LGTM development image verified on 2026-09-02.
# The digest is the multi-architecture image index and includes linux/arm64.
LGTM_VERSION=0.30.2
LGTM_IMAGE_DIGEST=sha256:069e79be4fcc648b13f22ded28146f0b2d94f7f48681a55aa4995566a0bbdd02

# Required local secrets. Generate a different value for every entry with:
#   openssl rand -hex 32
# Copy this file to .env, then fill every blank value below. Compose fails fast while any
# required value is blank. ENCRYPTION_KEY must remain exactly 64 hexadecimal characters.
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# Optional Collector-to-Langfuse HTTP Basic value: base64(public-key:secret-key).
# Leave blank until a local Langfuse project exists. Never commit a usable value.
LANGFUSE_AUTH_STRING=

# Non-secret backing-service identifiers.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
CLICKHOUSE_USER=clickhouse
MINIO_ROOT_USER=minio

# Optional headless initialization. Leave the whole group blank for UI-first setup.
# To enable it, set ORG_ID, PROJECT_ID, both project keys, USER_EMAIL, and USER_PASSWORD
# together. IDs and keys are create-once bootstrap inputs, not credential-rotation controls.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# Application evidence store on ParadeDB (PostgreSQL 17 with pg_search and pgvector),
# verified on 2026-09-02. The digest is the multi-architecture image index.
PARADEDB_VERSION=0.25.6-pg17
PARADEDB_IMAGE_DIGEST=sha256:044b8cc5b40159714e88e3f546fc74de11cf215c030190cc82c6627015d728ea
POSTGRES_APP_USER=app
POSTGRES_APP_DB=app
# Required secret for the application database; generate with openssl rand -hex 32.
POSTGRES_APP_PASSWORD=

# Investigation service deployment coordinates. The prototype has no authentication or
# authorization inputs. The public API
# process receives only AGENT_READER_DATABASE_URL and AGENT_WRITER_DATABASE_URL. The one-shot
# initializer receives only AGENT_OWNER_DATABASE_URL plus the two role passwords; Compose must not
# pass those initializer-only values to the API container.
INVESTIGATION_AGENT_HOST=0.0.0.0
INVESTIGATION_AGENT_PORT=8080
# Host port for the Next.js investigation UI. Its backend URL is wired internally by Compose.
INVESTIGATION_WEB_PORT=3002
EXPECTED_AGENT_INITIALIZER_VERSION=agent-runtime@1
# Required investigation database secrets. Generate distinct URL-safe passwords; the DSNs use
# Compose's internal postgres-app hostname and interpolate those passwords from this file.
AGENT_READER_PASSWORD=
AGENT_WRITER_PASSWORD=
AGENT_READER_DATABASE_URL=postgresql://agent_reader:${AGENT_READER_PASSWORD}@postgres-app:5432/app
AGENT_WRITER_DATABASE_URL=postgresql://agent_writer:${AGENT_WRITER_PASSWORD}@postgres-app:5432/app
AGENT_OWNER_DATABASE_URL=postgresql://app:${POSTGRES_APP_PASSWORD}@postgres-app:5432/app

# Dedicated evidence bucket and bucket-scoped MinIO identity. Use a long random secret;
# neither credential may be the MinIO root identity.
EVIDENCE_S3_BUCKET=evidence
EVIDENCE_S3_ACCESS_KEY=evidence-ingestion
EVIDENCE_S3_SECRET_KEY=
DATASET_EDITION=en

# Environment selector for every service's config/<service>/<name>.yaml. Always required.
ENVIRONMENT_NAME=local

# Ingestion policy (telemetry endpoints, log delivery, content capture, pool, throttle,
# chunking) is baselined in config/ingestion/local.yaml; services/ingestion/.env.example
# lists every key. Override one per run with, for example:
#   docker compose run --rm -e CAPTURE_AI_CONTENT=true ingestion

# Ingestion deployment contract (application policy such as pool, throttle, and chunking
# lives in config/ingestion/local.yaml). AWS credentials are temporary session credentials read by
# the AWS SDK credential chain; they are passed through to the container and are never
# application settings. Model identifiers and region are required by the ingestion
# service at startup and have no application default. Kept last so the values that change
# most often (per environment, per session) are quick to find and edit.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
