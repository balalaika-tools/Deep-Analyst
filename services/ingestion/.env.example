################################################################################
# ingestion — runtime environment contract
#
# Compose reads the repository-root .env and passes the REQUIRED values into the
# container (see compose.yaml, service `ingestion`). This file is the complete contract
# of the process itself: copy the REQUIRED block into the root .env, or export the
# variables when running `uv run --package ingestion ingest-case` locally.
################################################################################

################################################################################
# REQUIRED — the service fails at startup, naming the variable, when any is missing
################################################################################

# Selects config/ingestion/<name>.yaml. Always required; only `local` exists.
ENVIRONMENT_NAME=local

# SQLAlchemy URL of the application evidence store (postgres-app in Compose).
DATABASE_URL=postgresql+psycopg://app:replace-me@127.0.0.1:5432/app

# S3-compatible evidence store. The credentials must be scoped to this bucket only.
EVIDENCE_S3_ENDPOINT=http://127.0.0.1:9090
EVIDENCE_S3_BUCKET=evidence
EVIDENCE_S3_ACCESS_KEY=replace-me-evidence-user
EVIDENCE_S3_SECRET_KEY=replace-me-evidence-secret
DATASET_EDITION=en

# Bedrock runtime coordinates. No application default exists for any of them.
AWS_REGION=
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# AWS session credentials are read by the SDK credential chain, never by the service
# settings. Compose passes them through; locally the chain may also use a profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

################################################################################
# OVERRIDABLE — application policy baselined in config/ingestion/local.yaml
# Setting one here overrides the YAML key for this process only (in Compose:
# docker compose run --rm -e LLM_MAX_IN_FLIGHT=10 ingestion). Values shown are the
# baseline defaults.
################################################################################

# EMBEDDING_DIMENSIONS=1024
# CHUNK_WINDOW_CHARS=4000
# CHUNK_OVERLAP_CHARS=200
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_S=30
# DB_POOL_PRE_PING=true
# LLM_REQUESTS_PER_MINUTE=60
# LLM_MAX_IN_FLIGHT=60
# LLM_MAX_RETRIES=3
# LLM_REASONING_EFFORT=low
# OTEL_SERVICE_NAME=ingestion
# SERVICE_VERSION=dev
# OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://lgtm:4328/v1/traces
# LOG_EXPORT=otlp
# CAPTURE_AI_CONTENT=false
# LOG_LEVEL=INFO

################################################################################
# OPTIONAL — rare runtime-only variables for specific situations
################################################################################

# Resource identity for telemetry; the container hostname is used when unset.
SERVICE_INSTANCE_ID=
# Escape hatch when the baseline is not discoverable beside the installed package.
INGESTION_CONFIG_DIR=
