################################################################################
# investigation-agent — complete process environment contract
#
# Serving and initialization are separate entry points. Never expose the initializer-only owner
# credential or role passwords to the long-running serving container.
################################################################################

################################################################################
# REQUIRED — shared non-secret deployment inputs
################################################################################

ENVIRONMENT_NAME=local
INVESTIGATION_AGENT_HOST=0.0.0.0
INVESTIGATION_AGENT_PORT=8080
AWS_REGION=
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EXPECTED_AGENT_INITIALIZER_VERSION=agent-runtime@1

# AWS session credentials belong to the SDK credential chain, not application settings.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

################################################################################
# SERVING SECRETS — only the long-running API process receives these two DSNs
################################################################################

AGENT_READER_DATABASE_URL=postgresql://agent_reader:replace-me@127.0.0.1:5432/app
AGENT_WRITER_DATABASE_URL=postgresql://agent_writer:replace-me@127.0.0.1:5432/app

################################################################################
# INITIALIZER SECRETS — only the one-shot agent-db-init process receives these values
################################################################################

AGENT_OWNER_DATABASE_URL=postgresql://app:replace-me@127.0.0.1:5432/app
AGENT_READER_PASSWORD=replace-with-at-least-16-characters
AGENT_WRITER_PASSWORD=replace-with-at-least-16-characters

################################################################################
# OVERRIDABLE — application policy baselined in config/investigation-agent/local.yaml
################################################################################

# READER_POOL_MIN_SIZE=1
# READER_POOL_MAX_SIZE=5
# WRITER_POOL_MIN_SIZE=1
# WRITER_POOL_MAX_SIZE=5
# POOL_ACQUIRE_TIMEOUT_S=5.0
# READINESS_TIMEOUT_S=5.0
# SHUTDOWN_TIMEOUT_S=30.0
# TURN_TIMEOUT_S=120.0
# MODEL_TIMEOUT_S=45.0
# TOOL_TIMEOUT_S=30.0
# MODEL_RETRY_ATTEMPTS=3
# TOOL_RETRY_ATTEMPTS=3
# RETRY_INITIAL_DELAY_S=0.25
# RETRY_BACKOFF_FACTOR=2.0
# RETRY_MAX_DELAY_S=4.0
# RETRY_JITTER=true
# MAIN_MODEL_CALL_LIMIT=20
# MAIN_TOOL_CALL_LIMIT=12
# NESTED_MODEL_CALL_LIMIT=6
# NESTED_TOOL_CALL_LIMIT=3
# CLOSURE_MODEL_CALLS=1
# MAX_PHYSICAL_ATTEMPTS=40
# MAX_EVIDENCE_CARDS=200
# MAX_RETRIEVED_ROWS=256
# MAX_QUERY_ROWS=100
# MAX_RESULT_BYTES=1000000
# MAX_GRAPH_PATHS=50
# MAX_CONTEXT_TOKENS=32000
# MAX_ANSWER_CHARS=16000
# LEXICAL_WEIGHT=0.5
# VECTOR_WEIGHT=0.5
# RECIPROCAL_RANK_CONSTANT=60
# RETRIEVAL_TOP_K=20
# GRAPH_MAX_DEPTH=4
# GRAPH_MAX_NODES=100
# GRAPH_MAX_EDGES=200
# MAX_HISTORY_TURNS=50
# HISTORY_PAGE_SIZE=20
# HISTORY_MAX_PAGE_SIZE=100
# SSE_HEARTBEAT_S=15.0
# SSE_CHUNK_CHARS=512
# MODEL_TEMPERATURE=0.0
# MODEL_REASONING_EFFORT=low
# OTEL_SERVICE_NAME=investigation-agent
# SERVICE_VERSION=dev
# OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://lgtm:4328/v1/traces
# LOG_EXPORT=otlp
# CAPTURE_AI_CONTENT=false
# LOG_LEVEL=INFO

################################################################################
# OPTIONAL — rare runtime-only inputs
################################################################################

SERVICE_INSTANCE_ID=
INVESTIGATION_AGENT_CONFIG_DIR=
